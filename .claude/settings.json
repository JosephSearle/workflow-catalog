{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make help)",
      "Bash(make lint)",
      "Bash(make lint-ci)",
      "Bash(make lint-files *)",
      "Bash(make actionlint)",
      "Bash(make yamllint)",
      "Bash(make schema)",
      "Bash(make zizmor)",
      "Bash(make template-pins)",
      "Bash(make sync-template-pins)",
      "Bash(make new-workflow *)",
      "Bash(make new-action *)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(gh api repos/*/commits/*)",
      "Bash(gh api repos/*/git/ref/*)",
      "Bash(gh api repos/*/releases/*)"
    ],
    "deny": [
      "Edit(**/CHANGELOG.md)",
      "Edit(**/.release-please-manifest.json)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/lint-edited.sh",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
